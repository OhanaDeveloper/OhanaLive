# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Railway auto-injects DATABASE_URL in production. For local dev, set manually.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ohana_live

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Encryption (for journals/messages)
ENCRYPTION_KEY=your-encryption-key-here-32-bytes

# Email Configuration
# Option 1: Console (development only - prints to terminal)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Option 2: Resend (recommended for production - free tier: 100 emails/day)
# Sign up at https://resend.com and get an API key
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxx  # Your Resend API key from https://resend.com/api-keys

# Option 3: Gmail (requires app password - NOT your regular password)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx  # Gmail App Password from https://myaccount.google.com/apppasswords

DEFAULT_FROM_EMAIL=noreply@ohanarecovery.org

# Redis (for caching/sessions)
REDIS_URL=redis://localhost:6379/0

# Social Auth (only needed if/when social login launches)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GeoIP (optional - for location tracking)
GEOIP_PATH=/path/to/geoip/db
