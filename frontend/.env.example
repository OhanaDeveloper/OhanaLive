# Frontend environment variables for Ohana Recovery.
# Copy to .env.local for development; configure in the Vercel project for production.

# Canonical Zoom meeting URL. Overrides the in-code fallback in
# src/lib/meetings.ts. The TinyURL alias here lets the underlying Zoom URL be
# rotated without a code change — update the TinyURL target, not this file.
# Set to an empty string to disable join CTAs sitewide and route visitors
# through the /meeting interstitial fallback (988, Crisis Text Line,
# /recovery-network).
NEXT_PUBLIC_MEETING_ZOOM_URL=https://tinyurl.com/OhanaRecovery

# Django backend base URL. When unset, lib/api.ts falls back to the production
# Railway URL. For local dev against a local Django server, set to
# http://localhost:8000
# NEXT_PUBLIC_API_URL=https://ohanalive-backend-production.up.railway.app

# Google Analytics 4 measurement ID. When unset, the GA script is not injected.
# A hardcoded fallback of G-NY5ZGB6ZCY exists in
# components/analytics/GoogleAnalytics.tsx
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# reCAPTCHA v3 site key. Required for /login and /signup flows.
# Get one at https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<your reCAPTCHA v3 site key>

# Anthropic API key — used by /api/chat (the anonymous peer support widget).
# SERVER-SIDE ONLY. Not prefixed NEXT_PUBLIC_ on purpose — never expose to client.
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=<your Anthropic API key>
