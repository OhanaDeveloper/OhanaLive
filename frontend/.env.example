# Frontend environment variables for Ohana Recovery.
# Copy to .env.local for development; configure in the Vercel project for production.

# Canonical Zoom meeting URL. Overrides the fallback defined in src/lib/meetings.ts.
# Set to an empty string to disable join CTAs sitewide and route visitors through
# the /meeting interstitial fallback (988, Crisis Text Line, /support directory).
NEXT_PUBLIC_MEETING_ZOOM_URL=https://us06web.zoom.us/j/85215704370?pwd=AfvqYFXUgGmCeC6dCr6bieNAw070bs.1

# Django backend base URL. When unset, dynamic meeting/host fetches are skipped.
# NEXT_PUBLIC_API_URL=https://api.ohanarecovery.org

# Google Analytics 4 measurement ID. When unset, the GA script is not injected.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
